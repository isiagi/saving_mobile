{
  "expo": {
    "scheme": "Agalyawamm-scheme",
    "name": "Agalyawamm",
    "slug": "saving",
    "version": "1.0.9",
    "orientation": "portrait",
    "icon": "./assets/ada1.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/adaScreen.png",
      "resizeMode": "cover"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "permissions": [
        "WRITE_EXTERNAL_STORAGE",
        "READ_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/ada1.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.isiagi.Agalyawamm",
      "versionCode": 12
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you share them with your friends."
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "00df8350-e063-467b-bab7-d3ac49010278"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/04863753-a4ef-4e77-87e9-6eb26e7b14ce"
    },
    "owner": "isiagi"
  }
}
